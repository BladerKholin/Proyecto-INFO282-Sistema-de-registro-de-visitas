# Appium and WebDriver Configuration
WEBDRIVER_REMOTE_URL=http://localhost:4723
APK_PATH=path/to/your/app.apk

# Jira Integration Configuration
# Your Jira instance URL (e.g., https://yourcompany.atlassian.net)
JIRA_URL=https://your-company.atlassian.net

# Your Jira username (usually your email)
JIRA_USERNAME=your-email@company.com

# Your Jira API Token (generate from: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token-here

# Your Jira project key (e.g., TEST, BUG, PROJ)
JIRA_PROJECT_KEY=TEST

# Jira issue type for test failures (optional, defaults to 'Bug')
JIRA_ISSUE_TYPE=Bug

# Screenshot settings
ENABLE_SCREENSHOTS=true
SCREENSHOTS_DIR=screenshots
